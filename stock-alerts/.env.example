# ============================================================
# StockAlerts — environment configuration
# Copy this file to .env and fill in your values.
# In GitHub Actions, set these as repository secrets instead.
# ============================================================

# --- Supabase (PostgreSQL) ---
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Service role key (backend pipeline) — keep secret
SUPABASE_SERVICE_KEY=
# Anon key (read-only, used by the web dashboard)
SUPABASE_ANON_KEY=

# --- Alert threshold ---
# Trigger alert when an asset drops this % from its day's high
DROP_THRESHOLD_PCT=5

# --- News providers (optional; falls back to Google News RSS) ---
NEWSAPI_KEY=
MEDIASTACK_KEY=
MAX_NEWS_PER_ALERT=10

# --- Groq (LLM for analysis + email drafting) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Email (SMTP) ---
# Gmail example: smtp.gmail.com:587 with an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=neerajnishal@gmail.com
EMAIL_FROM=